{
  "name": "apple-proxy-profiles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["clients/*"],
  "scripts": {
    "test": "node --test test/*.test.js automation/test/*.test.js && npm --workspaces --if-present test",
    "build": "npm --workspaces --if-present run build",
    "fixtures": "npm --workspaces --if-present run fixtures",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "update:rules": "node scripts/update-rules.mjs --channel edge",
    "check:rules": "node scripts/update-rules.mjs --check --channel current",
    "explain:route": "node scripts/explain-route.mjs",
    "verify:anywhere": "npm --workspace @apple-proxy-profiles/anywhere run verify",
    "verify:egern": "npm --workspace @apple-proxy-profiles/egern run verify",
    "verify:shadowrocket": "npm --workspace @apple-proxy-profiles/shadowrocket run verify",
    "verify:surge": "npm --workspace @apple-proxy-profiles/surge run verify",
    "verify:singbox": "npm --workspace @apple-proxy-profiles/sing-box run verify",
    "verify:lightweight": "node --test test/lightweight-policy.test.js test/rule-model.test.js && npm run verify:shadowrocket && npm run verify:surge && npm run verify:egern && npm run verify:singbox && npm run verify:anywhere && node --test test/cross-client-routing.test.js test/rule-budgets.test.js",
    "verify": "npm run verify:lightweight && node scripts/verify.mjs"
  },
  "devDependencies": { "esbuild": "0.28.1", "protobufjs": "7.6.5" }
}
